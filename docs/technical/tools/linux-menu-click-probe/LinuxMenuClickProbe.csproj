<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>LinuxMenuClickProbe</AssemblyName>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <Target Name="RequireGamePath" BeforeTargets="ResolveReferences" Condition="'$(GamePath)' == ''">
    <Error Text="Set GamePath to a Linux Stardew Valley installation containing StardewModdingAPI.dll." />
  </Target>

  <ItemGroup>
    <Reference Include="StardewModdingAPI" HintPath="$(GamePath)/StardewModdingAPI.dll" Private="false" />
    <Reference Include="Stardew Valley" HintPath="$(GamePath)/Stardew Valley.dll" Private="false" />
    <Reference Include="MonoGame.Framework" HintPath="$(GamePath)/MonoGame.Framework.dll" Private="false" />
    <Reference Include="xTile" HintPath="$(GamePath)/xTile.dll" Private="false" />
  </ItemGroup>
</Project>
