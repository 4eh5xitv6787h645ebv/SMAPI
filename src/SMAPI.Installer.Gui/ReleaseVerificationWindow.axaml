<Window
    x:Class="StardewModdingAPI.Installer.Gui.ReleaseVerificationWindow"
    x:DataType="vm:ReleaseVerificationViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:StardewModdingAPI.Installer.Gui"
    xmlns:packages="using:StardewModdingAPI.Installer.Core.Packages"
    xmlns:vm="using:StardewModdingAPI.Installer.Gui.ViewModels"
    Title="SMAPI Linux Installer — Release verification"
    Width="980"
    Height="760"
    MinWidth="420"
    MinHeight="560"
    WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector="Border.keyboard-focus:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource InstallerFocusBrush}" />
      <Setter Property="BorderThickness" Value="3" />
    </Style>
  </Window.Styles>

  <ScrollViewer
      x:Name="PageScrollViewer"
      HorizontalScrollBarVisibility="Disabled"
      VerticalScrollBarVisibility="Auto">
    <Grid x:Name="PageGrid" Margin="28" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="18">
      <StackPanel Grid.Row="0" Spacing="4">
        <TextBlock
            AutomationProperties.HeadingLevel="1"
            FontSize="30"
            FontWeight="Bold"
            Text="SMAPI Linux Installer"
            TextWrapping="Wrap" />
        <TextBlock Classes="muted" FontSize="16" Text="Experimental Linux release verification" TextWrapping="Wrap" />
        <local:InstallerDiagnosticsAccess x:Name="DiagnosticsAccess" />
      </StackPanel>

      <Border
          Grid.Row="1"
          Padding="14"
          Background="{DynamicResource InstallerInfoBackgroundBrush}"
          BorderBrush="{DynamicResource InstallerInfoBorderBrush}"
          BorderThickness="1"
          CornerRadius="8">
        <TextBlock
            FontWeight="SemiBold"
            Text="Experimental prereleases only. A verified download is not an installation; you will review a separate change plan before any game files can change."
            TextWrapping="Wrap" />
      </Border>

      <Border Grid.Row="2" Classes="card">
        <StackPanel Spacing="14">
          <Border
              x:Name="StatusRegion"
              Classes="keyboard-focus"
              TabIndex="0"
              Focusable="True"
              AutomationProperties.LiveSetting="{Binding StatusLiveSetting}"
              AutomationProperties.Name="{Binding LiveAnnouncement}">
            <StackPanel Spacing="8">
              <TextBlock
                  x:Name="StatusHeading"
                  AutomationProperties.HeadingLevel="2"
                  FontSize="22"
                  FontWeight="SemiBold"
                  Text="{Binding Heading}"
                  TextWrapping="Wrap" />
              <TextBlock Classes="muted" Text="{Binding Message}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border
              x:Name="ErrorRegion"
              Classes="keyboard-focus"
              Padding="12"
              TabIndex="0"
              Focusable="True"
              IsVisible="{Binding IsErrorVisible}"
              AutomationProperties.LiveSetting="Assertive"
              AutomationProperties.Name="{Binding LiveAnnouncement}"
              Background="{DynamicResource InstallerErrorBackgroundBrush}"
              BorderBrush="{DynamicResource InstallerErrorBorderBrush}"
              BorderThickness="2"
              CornerRadius="6">
            <TextBlock
                x:Name="ErrorMessageText"
                Text="Verification is blocked. No game files were changed. Follow the safe next step in the error message."
                TextWrapping="Wrap" />
          </Border>

          <Border
              x:Name="FailureEvidence"
              Padding="12"
              IsVisible="{Binding IsFailureEvidenceVisible}"
              AutomationProperties.Name="Observed release verification evidence"
              Background="{DynamicResource InstallerInsetBackgroundBrush}"
              CornerRadius="6">
            <StackPanel Spacing="8">
              <TextBlock
                  AutomationProperties.HeadingLevel="3"
                  FontWeight="SemiBold"
                  Text="Observed verification evidence"
                  TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding FailureEvidence}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ReleaseVerificationEvidenceRow">
                    <Border
                        Margin="0,0,0,7"
                        Padding="8"
                        AutomationProperties.Name="{Binding AccessibleName}"
                        Background="{DynamicResource InstallerCardBackgroundBrush}"
                        CornerRadius="4">
                      <StackPanel Spacing="2">
                        <TextBlock Classes="muted" FontSize="13" Text="{Binding Label}" TextWrapping="Wrap" />
                        <TextBlock FontWeight="SemiBold" Text="{Binding Value}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <StackPanel Spacing="8">
            <Label Content="_Experimental release" Target="{Binding #ReleaseSelector}" />
            <ComboBox
                x:Name="ReleaseSelector"
                Classes="focus-ring"
                TabIndex="1"
                AutomationProperties.AccessKey="Alt+E"
                AutomationProperties.Name="Experimental Linux release"
                AutomationProperties.HelpText="Choose one complete six-file prerelease reviewed by the installer."
                IsEnabled="{Binding IsReleaseSelectorEnabled}"
                ItemsSource="{Binding Releases}"
                SelectedItem="{Binding SelectedRelease}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="packages:ReviewedReleaseCandidate">
                  <TextBlock Text="{Binding DisplayLabel}" TextWrapping="Wrap" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock
                x:Name="ReleaseDetail"
                Classes="muted"
                AutomationProperties.Name="Selected release details"
                Text="{Binding ReleaseDetail}"
                TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel IsVisible="{Binding IsProgressVisible}" Spacing="8">
            <ProgressBar
                x:Name="ReleaseProgress"
                Height="12"
                Minimum="0"
                Maximum="100"
                IsIndeterminate="{Binding IsProgressIndeterminate}"
                Value="{Binding ProgressValue}"
                AutomationProperties.Name="Overall release download and verification progress"
                AutomationProperties.HelpText="{Binding ProgressText}" />
            <TextBlock
                x:Name="ProgressText"
                Classes="muted"
                Text="{Binding ProgressText}"
                TextWrapping="Wrap" />
          </StackPanel>

          <Border
              x:Name="VerifiedEvidence"
              Padding="14"
              IsVisible="{Binding IsVerifiedVisible}"
              AutomationProperties.Name="Verified package evidence"
              Background="{DynamicResource InstallerSuccessBackgroundBrush}"
              BorderBrush="{DynamicResource InstallerSuccessBorderBrush}"
              BorderThickness="2"
              CornerRadius="8">
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="7">
              <TextBlock Grid.Row="0" FontWeight="Bold" Foreground="{DynamicResource InstallerSuccessForegroundBrush}" Text="✓" />
              <TextBlock Grid.Row="0" Grid.Column="1" FontWeight="SemiBold" Text="Package integrity: verified" TextWrapping="Wrap" />
              <TextBlock Grid.Row="1" FontWeight="Bold" Foreground="{DynamicResource InstallerSuccessForegroundBrush}" Text="✓" />
              <TextBlock Grid.Row="1" Grid.Column="1" FontWeight="SemiBold" Text="GitHub provenance: verified" TextWrapping="Wrap" />
              <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Classes="muted" Text="These checks are separate. Nothing has been installed yet." TextWrapping="Wrap" />
              <TextBlock
                  Grid.Row="3"
                  Grid.ColumnSpan="2"
                  Classes="muted"
                  AutomationProperties.Name="Authoritative verified release identity"
                  Text="{Binding VerifiedIdentityDetail}"
                  TextWrapping="Wrap" />
            </Grid>
          </Border>

          <Border Padding="12" Background="{DynamicResource InstallerInsetBackgroundBrush}" CornerRadius="6">
            <StackPanel Spacing="3">
              <TextBlock Classes="muted" FontSize="13" Text="DURABLE STATE" />
              <TextBlock
                  x:Name="DurableState"
                  AutomationProperties.Name="Installer durable state"
                  FontWeight="SemiBold"
                  Text="{Binding DurableState}"
                  TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <WrapPanel Orientation="Horizontal">
            <Button
                x:Name="DownloadButton"
                Classes="primary focus-ring"
                Margin="0,0,12,10"
                TabIndex="2"
                AutomationProperties.AccessKey="Alt+W"
                AutomationProperties.Name="Download and verify selected release"
                AutomationProperties.HelpText="Downloads and verifies the selected release without installing it."
                Command="{Binding DownloadAndVerifyCommand}"
                IsVisible="{Binding IsDownloadActionVisible}"
                Content="Do_wnload and verify" />
            <Button
                x:Name="LocalPackageButton"
                Classes="focus-ring"
                Margin="0,0,12,10"
                TabIndex="3"
                AutomationProperties.AccessKey="Alt+L"
                AutomationProperties.Name="Use local release package folder"
                AutomationProperties.HelpText="Choose one local folder containing exactly the six release files. The package is fully verified before use, and the selected path is not displayed or retained for retry."
                Command="{Binding UseLocalPackageCommand}"
                IsVisible="{Binding IsLocalPackageActionVisible}"
                Content="Use _local package folder…" />
            <Button
                x:Name="RetryButton"
                Classes="primary focus-ring"
                Margin="0,0,12,10"
                TabIndex="4"
                AutomationProperties.AccessKey="Alt+T"
                AutomationProperties.Name="{Binding RetryAutomationName}"
                Command="{Binding RetryCommand}"
                IsVisible="{Binding IsRetryVisible}"
                Content="_Try again" />
            <Button
                x:Name="ExitButton"
                Classes="primary focus-ring"
                Margin="0,0,12,10"
                TabIndex="5"
                AutomationProperties.AccessKey="Alt+X"
                AutomationProperties.Name="Close installer and end this verification session"
                AutomationProperties.HelpText="Closes this verification session without changing game files."
                Click="OnExitClick"
                IsVisible="{Binding IsExitVisible}"
                Content="E_xit installer" />
            <Button
                x:Name="ContinueButton"
                Classes="primary focus-ring"
                Margin="0,0,12,10"
                TabIndex="6"
                AutomationProperties.AccessKey="Alt+N"
                AutomationProperties.Name="Continue to game folder selection"
                AutomationProperties.HelpText="Continues to game selection; it does not install immediately."
                Command="{Binding ContinueCommand}"
                IsVisible="{Binding IsContinueVisible}"
                Content="Co_ntinue to game folder" />
            <Button
                x:Name="CancelButton"
                Classes="focus-ring"
                Margin="0,0,12,10"
                TabIndex="7"
                AutomationProperties.AccessKey="Alt+C"
                AutomationProperties.Name="Cancel active release action"
                AutomationProperties.HelpText="Stops the current bounded step and removes retained release files."
                Command="{Binding CancelCommand}"
                IsVisible="{Binding IsCancelVisible}"
                Content="_Cancel" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <Border
          x:Name="ManualFallbackCard"
          Grid.Row="3"
          Classes="card keyboard-focus"
          Focusable="True"
          TabIndex="8"
          AutomationProperties.Name="Manual terminal and headless installation help. Review the prerequisites, commands, exit meanings, and legacy-path limitations shown in this section.">
        <StackPanel Spacing="14">
          <StackPanel Spacing="4">
            <TextBlock
                x:Name="ManualFallbackHeading"
                AutomationProperties.HeadingLevel="2"
                Classes="section-title"
                Text="Manual terminal and headless installation"
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="ManualFallbackIntroduction"
                Text="These passive instructions do not start a process, open another app, read or write the clipboard, or change game files. Use only files from the same verified release package."
                TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Spacing="5">
            <TextBlock
                x:Name="ManualPrerequisitesHeading"
                AutomationProperties.HeadingLevel="3"
                FontWeight="SemiBold"
                Text="Before extracting"
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="ManualPrerequisitesText"
                Text="Close Stardew Valley. Back up your saves and Mods. Download and verify all six public release files before extracting the installer ZIP. Run every command as your normal desktop user; never use root or sudo."
                TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Spacing="5">
            <TextBlock
                x:Name="ManualInteractiveHeading"
                AutomationProperties.HeadingLevel="3"
                FontWeight="SemiBold"
                Text="Interactive terminal path"
                TextWrapping="Wrap" />
            <Border x:Name="ManualInteractiveCommandCard" Padding="10" Background="{DynamicResource InstallerInsetBackgroundBrush}" CornerRadius="4">
              <TextBlock
                  x:Name="ManualInteractiveCommand"
                  AutomationProperties.Name="Interactive command: bash &quot;install on Linux.sh&quot;"
                  FontFamily="monospace"
                  Text="bash &quot;install on Linux.sh&quot;"
                  TextWrapping="Wrap" />
            </Border>
            <TextBlock
                x:Name="ManualFileManagerFallbackText"
                Text="If opening install on Linux.sh from your file manager cannot start a supported terminal, open a terminal in the extracted package folder and run the exact command above. This wrapper is interactive, accepts no options, and rejects headless flags."
                TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Spacing="5">
            <TextBlock
                x:Name="ManualHeadlessHeading"
                AutomationProperties.HeadingLevel="3"
                FontWeight="SemiBold"
                Text="Headless install or uninstall"
                TextWrapping="Wrap" />
            <TextBlock Text="Call the installer executable directly as shown; do not append flags to the interactive wrapper. Replace the quoted absolute placeholder with the game folder containing the Stardew Valley executable." TextWrapping="Wrap" />
            <Border x:Name="ManualHeadlessCommandCard" Padding="10" Background="{DynamicResource InstallerInsetBackgroundBrush}" CornerRadius="4">
              <StackPanel Spacing="8">
                <TextBlock
                    x:Name="ManualHeadlessInstallCommand"
                    AutomationProperties.Name="Headless install command: ./internal/linux/SMAPI.Installer --no-prompt --install --game-path &quot;/absolute/path/to/Stardew Valley&quot;"
                    FontFamily="monospace"
                    Text="./internal/linux/SMAPI.Installer --no-prompt --install --game-path &quot;/absolute/path/to/Stardew Valley&quot;"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="ManualHeadlessUninstallCommand"
                    AutomationProperties.Name="Headless uninstall command: ./internal/linux/SMAPI.Installer --no-prompt --uninstall --game-path &quot;/absolute/path/to/Stardew Valley&quot;"
                    FontFamily="monospace"
                    Text="./internal/linux/SMAPI.Installer --no-prompt --uninstall --game-path &quot;/absolute/path/to/Stardew Valley&quot;"
                    TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Spacing="5">
            <TextBlock
                x:Name="ManualExitHeading"
                AutomationProperties.HeadingLevel="3"
                FontWeight="SemiBold"
                Text="Headless exit meanings"
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="ManualExitText"
                Text="Exit 0: the installer reported completion. Exit 2: a handled refusal or validation failure, including invalid arguments. Exit 1: an unexpected exception, filesystem failure, or runtime failure; it does not prove that files are unchanged or rolled back. Shell or signal statuses are also possible. No exit code alone proves rollback."
                TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Spacing="5">
            <TextBlock
                x:Name="ManualPrivacyHeading"
                AutomationProperties.HeadingLevel="3"
                FontWeight="SemiBold"
                Text="Terminal-output privacy"
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="ManualPrivacyText"
                Text="Terminal and headless output can include game paths and full exception text. Review it before sharing; it is not the sanitized graphical diagnostic snapshot."
                TextWrapping="Wrap" />
          </StackPanel>

          <Border x:Name="ManualLimitationsCard" Padding="12" Background="{DynamicResource InstallerWarningBackgroundBrush}" BorderBrush="{DynamicResource InstallerWarningBorderBrush}" BorderThickness="1" CornerRadius="6">
            <StackPanel Spacing="5">
              <TextBlock
                  x:Name="ManualLimitationsHeading"
                  AutomationProperties.HeadingLevel="3"
                  FontWeight="SemiBold"
                  Text="Legacy-path limitations"
                  TextWrapping="Wrap" />
              <TextBlock
                  x:Name="ManualLimitationsText"
                  Text="The terminal and headless legacy path supports install and uninstall only. It does not download or verify the release, or provide the GUI's reviewed plan, receipt-authenticated Update or Repair, Backup operation, journal and interrupted recovery, recovery-history pruning, or authenticated Rollback. Running Install again is not an authenticated Update. Last-resort raw install.dat extraction is a separate fresh-install-only procedure in the release guide; it has none of these safety checks. Never recursively delete the game folder, Mods, saves, or logs. Use the graphical workflow when you need its reviewed capabilities."
                  TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</Window>
