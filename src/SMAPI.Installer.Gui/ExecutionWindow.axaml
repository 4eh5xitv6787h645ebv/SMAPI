<Window
    x:Class="StardewModdingAPI.Installer.Gui.ExecutionWindow"
    x:DataType="vm:ExecutionViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:StardewModdingAPI.Installer.Gui"
    xmlns:vm="using:StardewModdingAPI.Installer.Gui.ViewModels"
    Title="SMAPI Linux Installer — Run operation"
    Width="860"
    Height="700"
    MinWidth="420"
    MinHeight="540"
    WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector="Border.keyboard-focus:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource InstallerFocusBrush}" />
      <Setter Property="BorderThickness" Value="3" />
    </Style>
  </Window.Styles>

  <ScrollViewer x:Name="PageScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid x:Name="PageGrid" Margin="28" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="18">
      <StackPanel Grid.Row="0" Spacing="4">
        <TextBlock AutomationProperties.HeadingLevel="1" FontSize="30" FontWeight="Bold" Text="Run confirmed installer plan" TextWrapping="Wrap" />
        <TextBlock Classes="muted" FontSize="16" Text="Linux desktop installer" TextWrapping="Wrap" />
        <local:InstallerDiagnosticsAccess x:Name="DiagnosticsAccess" />
      </StackPanel>

      <Border
          x:Name="ConfirmedPlanRegion"
          Grid.Row="1"
          Padding="14"
          AutomationProperties.Name="Confirmed plan identity and safety"
          Background="{DynamicResource InstallerInfoBackgroundBrush}"
          BorderBrush="{DynamicResource InstallerInfoBorderBrush}"
          BorderThickness="1"
          CornerRadius="8">
        <StackPanel Spacing="6">
          <TextBlock AutomationProperties.HeadingLevel="2" FontWeight="SemiBold" Text="Confirmed plan identity and safety" TextWrapping="Wrap" />
          <TextBlock Text="{Binding BoundaryDetail}" TextWrapping="Wrap" />
          <TextBlock Classes="muted" Text="{Binding PlanDetail}" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding ConfirmationRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ExecutionFactRow">
                <Grid Margin="0,3" ColumnDefinitions="2*,3*" AutomationProperties.Name="{Binding AccessibleName}">
                  <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="{Binding Label}" TextWrapping="Wrap" />
                  <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Grid.Row="2" Classes="card">
        <StackPanel Spacing="14">
          <Border
              x:Name="StatusRegion"
              Classes="keyboard-focus"
              Focusable="True"
              TabIndex="0"
              AutomationProperties.LiveSetting="{Binding StatusLiveSetting}"
              AutomationProperties.Name="{Binding LiveAnnouncement}">
            <StackPanel Spacing="7">
              <TextBlock AutomationProperties.HeadingLevel="2" FontSize="23" FontWeight="SemiBold" Text="{Binding Heading}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border
              x:Name="ProblemRegion"
              Classes="keyboard-focus"
              Focusable="True"
              TabIndex="1"
              IsVisible="{Binding IsProblemVisible}"
              AutomationProperties.LiveSetting="Assertive"
              AutomationProperties.Name="{Binding LiveAnnouncement}"
              Padding="12"
              Background="{DynamicResource InstallerErrorBackgroundBrush}"
              BorderBrush="{DynamicResource InstallerErrorBorderBrush}"
              BorderThickness="2"
              CornerRadius="6">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
          </Border>

          <StackPanel IsVisible="{Binding IsProgressVisible}" Spacing="8">
            <ProgressBar
                x:Name="OperationProgress"
                Height="14"
                IsIndeterminate="{Binding IsProgressIndeterminate}"
                Maximum="{Binding ProgressMaximum}"
                Value="{Binding ProgressValue}"
                AutomationProperties.Name="{Binding ProgressDetail}" />
            <TextBlock Text="{Binding ProgressDetail}" TextWrapping="Wrap" />
            <Border x:Name="StageLiveRegion" IsVisible="{Binding HasProgressStage}" AutomationProperties.LiveSetting="{Binding StageLiveSetting}" AutomationProperties.Name="{Binding StageAnnouncement}">
              <TextBlock Classes="muted" Text="{Binding StageAnnouncement}" TextWrapping="Wrap" />
            </Border>
          </StackPanel>

          <WrapPanel x:Name="ActionPanel" Orientation="Horizontal">
            <Button
                x:Name="CancelButton"
                Classes="focus-ring"
                Margin="0,0,12,10"
                TabIndex="2"
                IsVisible="{Binding IsCancelVisible}"
                AutomationProperties.AccessKey="Alt+C"
                AutomationProperties.Name="{Binding CancelAccessibleName}"
                AutomationProperties.HelpText="{Binding CancelHelpText}"
                Command="{Binding CancelCommand}"
                Content="{Binding CancelLabel}" />
            <Button
                x:Name="RunButton"
                Classes="primary focus-ring"
                Margin="0,0,12,10"
                TabIndex="3"
                IsVisible="{Binding IsRunVisible}"
                AutomationProperties.AccessKey="Alt+R"
                AutomationProperties.Name="{Binding RunAccessibleName}"
                AutomationProperties.HelpText="This explicit action starts the reviewed installer plan exactly once."
                Command="{Binding RunCommand}"
                Content="{Binding RunLabel}" />
            <Button
                x:Name="RecoverButton"
                Classes="primary focus-ring"
                Margin="0,0,12,10"
                TabIndex="4"
                IsVisible="{Binding IsRecoverVisible}"
                AutomationProperties.AccessKey="Alt+V"
                AutomationProperties.Name="Run interrupted recovery"
                AutomationProperties.HelpText="Starts a fresh authenticated recovery attempt. After admission it cannot be cancelled."
                Command="{Binding RecoverCommand}"
                Content="Run reco_very" />
            <Button
                x:Name="ExitButton"
                Classes="focus-ring"
                Margin="0,0,12,10"
                TabIndex="5"
                IsVisible="{Binding IsExitVisible}"
                AutomationProperties.AccessKey="Alt+X"
                AutomationProperties.Name="Close installer"
                Command="{Binding ExitCommand}"
                Content="E_xit" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <Border
          x:Name="ResultRegion"
          Grid.Row="3"
          Classes="card keyboard-focus"
          Focusable="True"
          TabIndex="6"
          IsVisible="{Binding IsResultVisible}"
          AutomationProperties.LiveSetting="{Binding ResultLiveSetting}"
          AutomationProperties.Name="{Binding LiveAnnouncement}">
        <StackPanel Spacing="10">
          <TextBlock AutomationProperties.HeadingLevel="2" Classes="section-title" Text="Exact durable result" />
          <ItemsControl ItemsSource="{Binding ResultRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ExecutionFactRow">
                <Grid Margin="0,3" ColumnDefinitions="2*,3*" AutomationProperties.Name="{Binding AccessibleName}">
                  <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="{Binding Label}" TextWrapping="Wrap" />
                  <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border
          Grid.Row="4"
          Padding="12"
          IsVisible="{Binding IsSettlementWarningVisible}"
          Background="{DynamicResource InstallerWarningBackgroundBrush}"
          BorderBrush="{DynamicResource InstallerWarningBorderBrush}"
          BorderThickness="1"
          CornerRadius="6"
          AutomationProperties.Name="{Binding SettlementWarning}">
        <TextBlock x:Name="SettlementWarningText" Text="{Binding SettlementWarning}" TextWrapping="Wrap" />
      </Border>
    </Grid>
  </ScrollViewer>
</Window>
