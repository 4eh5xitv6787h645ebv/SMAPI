<Window
    x:Class="StardewModdingAPI.Installer.Gui.PlanReviewWindow"
    x:DataType="vm:PlanReviewViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:StardewModdingAPI.Installer.Gui"
    xmlns:vm="using:StardewModdingAPI.Installer.Gui.ViewModels"
    Title="SMAPI Linux Installer — Plan review"
    Width="980"
    Height="760"
    MinWidth="420"
    MinHeight="560"
    WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector="Border.keyboard-focus:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource InstallerFocusBrush}" />
      <Setter Property="BorderThickness" Value="3" />
    </Style>
  </Window.Styles>

  <ScrollViewer
      x:Name="PageScrollViewer"
      HorizontalScrollBarVisibility="Disabled"
      VerticalScrollBarVisibility="Auto">
    <Grid x:Name="PageGrid" Margin="28" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="18">
      <StackPanel Grid.Row="0" Spacing="4">
        <TextBlock
            AutomationProperties.HeadingLevel="1"
            FontSize="30"
            FontWeight="Bold"
            Text="Review an installer plan"
            TextWrapping="Wrap" />
        <TextBlock Classes="muted" FontSize="16" Text="Bounded read-only Linux plan inspection" TextWrapping="Wrap" />
        <local:InstallerDiagnosticsAccess x:Name="DiagnosticsAccess" />
      </StackPanel>

      <Border
          x:Name="InspectionBoundary"
          Grid.Row="1"
          Padding="14"
          AutomationProperties.Name="Review first. Candidate choices can refresh this read-only plan. Confirming prepares a separate final Run screen and changes no files."
          Background="{DynamicResource InstallerInfoBackgroundBrush}"
          BorderBrush="{DynamicResource InstallerInfoBorderBrush}"
          BorderThickness="1"
          CornerRadius="8">
        <TextBlock
            FontWeight="SemiBold"
            Text="Review first. Candidate choices can refresh this read-only plan. Confirming prepares a separate final Run screen and changes no files."
            TextWrapping="Wrap" />
      </Border>

      <Border Grid.Row="2" Classes="card">
        <StackPanel Spacing="10">
          <TextBlock AutomationProperties.HeadingLevel="2" Classes="section-title" Text="Bound verified context" />
          <Border
              x:Name="GameContextRegion"
              AutomationProperties.Name="{Binding GameAccessibleName}">
            <TextBlock
                x:Name="GameDetail"
                Text="{Binding GameDetail}"
                TextWrapping="Wrap" />
          </Border>
          <TextBlock
              x:Name="ReleaseDetail"
              AutomationProperties.Name="{Binding ReleaseAccessibleName}"
              Text="{Binding ReleaseDetail}"
              TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Grid.Row="3" Classes="card">
        <StackPanel Spacing="14">
          <Border
              x:Name="StatusRegion"
              Classes="keyboard-focus"
              TabIndex="0"
              Focusable="True"
              AutomationProperties.LiveSetting="{Binding StatusLiveSetting}"
              AutomationProperties.Name="{Binding LiveAnnouncement}">
            <StackPanel Spacing="8">
              <TextBlock
                  x:Name="StatusHeading"
                  AutomationProperties.HeadingLevel="2"
                  FontSize="22"
                  FontWeight="SemiBold"
                  Text="{Binding Heading}"
                  TextWrapping="Wrap" />
              <TextBlock Classes="muted" Text="{Binding Message}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border
              x:Name="ErrorRegion"
              Classes="keyboard-focus"
              Padding="12"
              TabIndex="0"
              Focusable="True"
              IsVisible="{Binding IsErrorVisible}"
              AutomationProperties.LiveSetting="Assertive"
              AutomationProperties.Name="{Binding LiveAnnouncement}"
              Background="{DynamicResource InstallerErrorBackgroundBrush}"
              BorderBrush="{DynamicResource InstallerErrorBorderBrush}"
              BorderThickness="2"
              CornerRadius="6">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
          </Border>

          <ProgressBar
              x:Name="InspectionProgress"
              Height="12"
              IsIndeterminate="True"
              IsVisible="{Binding IsBusy}"
              AutomationProperties.Name="Read-only plan inspection in progress" />

          <StackPanel Spacing="8">
            <Label Content="_Operation to inspect" Target="{Binding #OperationList}" />
            <ListBox
                x:Name="OperationList"
                Classes="focus-ring"
                Focusable="True"
                MaxHeight="330"
                TabIndex="1"
                AutomationProperties.AccessKey="Alt+O"
                AutomationProperties.Name="Read-only installer operations"
                AutomationProperties.HelpText="Choose exactly one operation, then use Inspect plan. Selecting an item does not run a backend request."
                IsEnabled="{Binding IsOperationSelectionEnabled}"
                ItemsSource="{Binding OperationChoices}"
                SelectedItem="{Binding SelectedOperation}">
              <ListBox.Styles>
                <Style Selector="ListBoxItem" x:CompileBindings="False">
                  <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:PlanReviewOperationChoice">
                  <StackPanel Margin="4" Spacing="3">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Label}" TextWrapping="Wrap" />
                    <TextBlock Classes="muted" Text="{Binding Summary}" TextWrapping="Wrap" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>

          <Border Padding="12" Background="{DynamicResource InstallerInsetBackgroundBrush}" CornerRadius="6">
            <StackPanel Spacing="3">
              <TextBlock Classes="muted" FontSize="13" Text="DURABLE STATE" />
              <TextBlock
                  x:Name="DurableState"
                  AutomationProperties.Name="Installer durable state"
                  FontWeight="SemiBold"
                  Text="{Binding DurableState}"
                  TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <WrapPanel Orientation="Horizontal">
            <Button
                x:Name="InspectButton"
                Classes="primary focus-ring"
                Margin="0,0,12,10"
                TabIndex="2"
                AutomationProperties.AccessKey="Alt+I"
                AutomationProperties.Name="Inspect selected plan"
                AutomationProperties.HelpText="Requests a bounded read-only plan summary. It cannot approve, confirm, or run a plan."
                Command="{Binding InspectCommand}"
                IsVisible="{Binding IsInspectVisible}"
                Content="_Inspect plan" />
            <Button
                x:Name="RetryButton"
                Classes="primary focus-ring"
                Margin="0,0,12,10"
                TabIndex="3"
                AutomationProperties.AccessKey="Alt+T"
                AutomationProperties.Name="Try read-only inspection again"
                Command="{Binding RetryCommand}"
                IsVisible="{Binding IsRetryVisible}"
                Content="_Try inspection again" />
            <Button
                x:Name="CancelButton"
                Classes="focus-ring"
                Margin="0,0,12,10"
                TabIndex="4"
                AutomationProperties.AccessKey="Alt+C"
                AutomationProperties.Name="Cancel active plan inspection"
                AutomationProperties.HelpText="Stops the read-only request and closes this verified backend session."
                Command="{Binding CancelCommand}"
                IsVisible="{Binding IsCancelVisible}"
                Content="_Cancel" />
            <Button
                x:Name="ExitButton"
                Classes="primary focus-ring"
                Margin="0,0,12,10"
                TabIndex="5"
                AutomationProperties.AccessKey="Alt+E"
                AutomationProperties.Name="Exit installer"
                AutomationProperties.HelpText="Closes this terminal plan-review session. Reopen the installer to start another verified session."
                Command="{Binding ExitCommand}"
                IsVisible="{Binding IsExitVisible}"
                Content="_Exit installer" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <Border
          x:Name="RecoveryReviewRegion"
          Grid.Row="4"
          Classes="card"
          IsVisible="{Binding IsRecoverySectionVisible}"
          AutomationProperties.Name="Rollback from recovery history. Loading, selecting, and inspecting a rollback changes no files. Execution remains on a separate final Run screen.">
        <StackPanel Spacing="12">
          <StackPanel Spacing="5">
            <TextBlock
                AutomationProperties.HeadingLevel="2"
                Classes="section-title"
                Text="Rollback from recovery history" />
            <TextBlock
                Text="Recovery history is listed only when you request it. Loading, selecting, and inspecting a rollback changes no files. After confirmation, execution remains on a separate final Run screen."
                TextWrapping="Wrap" />
            <TextBlock
                Classes="muted"
                Text="No recovery point is selected automatically. Review one exact local recovery point before requesting its read-only rollback plan."
                TextWrapping="Wrap" />
          </StackPanel>

          <Border
              x:Name="RecoveryStatusRegion"
              Classes="keyboard-focus"
              Focusable="True"
              TabIndex="6"
              AutomationProperties.LiveSetting="Off"
              AutomationProperties.Name="{Binding RecoveryStatusDetail}">
            <TextBlock
                FontWeight="SemiBold"
                Text="{Binding RecoveryStatusDetail}"
                TextWrapping="Wrap" />
          </Border>

          <ProgressBar
              x:Name="RecoveryProgress"
              Height="12"
              IsIndeterminate="True"
              IsVisible="{Binding IsRecoveryBusy}"
              AutomationProperties.Name="Loading local recovery history" />

          <TextBlock
              x:Name="RecoveryEmptyDetail"
              Classes="muted"
              IsVisible="{Binding IsRecoveryEmptyVisible}"
              Text="No committed recovery points are available for this game folder."
              TextWrapping="Wrap" />

          <StackPanel IsVisible="{Binding IsRecoveryListVisible}" Spacing="6">
            <Label Content="Recovery _point to inspect" Target="{Binding #RecoveryList}" />
            <ListBox
                x:Name="RecoveryList"
                Classes="focus-ring"
                Focusable="True"
                MaxHeight="360"
                MinHeight="120"
                TabIndex="7"
                AutomationProperties.AccessKey="Alt+P"
                AutomationProperties.Name="Local recovery points"
                AutomationProperties.HelpText="Use Up and Down Arrow to review exact recovery points. No item is selected automatically, and selection changes no files."
                ItemsSource="{Binding RecoveryChoices}"
                SelectedItem="{Binding SelectedRecoveryChoice}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                SelectionMode="Single">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.Styles>
                <Style Selector="ListBoxItem" x:CompileBindings="False">
                  <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:PlanReviewRecoveryChoice">
                  <StackPanel Margin="4" MaxWidth="760" Spacing="3">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                    <TextBlock Classes="muted" Text="{Binding Detail}" TextWrapping="Wrap" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>

          <WrapPanel Orientation="Horizontal">
            <Button
                x:Name="LoadRecoveriesButton"
                Classes="focus-ring"
                Margin="0,0,12,10"
                TabIndex="8"
                AutomationProperties.AccessKey="Alt+H"
                AutomationProperties.Name="Load or refresh local recovery history"
                AutomationProperties.HelpText="Explicitly lists bounded local recovery points. It does not select, inspect, confirm, or execute a rollback and changes no files."
                Command="{Binding LoadRecoveriesCommand}"
                IsVisible="{Binding IsLoadRecoveriesVisible}"
                Content="Load or refresh _history" />
            <Button
                x:Name="InspectRollbackButton"
                Classes="primary focus-ring"
                Margin="0,0,12,10"
                TabIndex="9"
                AutomationProperties.AccessKey="Alt+B"
                AutomationProperties.Name="Inspect selected rollback plan"
                AutomationProperties.HelpText="Consumes the exact selected recovery point only to request a read-only rollback plan. It changes no files and cannot execute the plan."
                Command="{Binding InspectRollbackCommand}"
                IsVisible="{Binding IsInspectRollbackVisible}"
                Content="Inspect roll_back" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <Border Grid.Row="5" Classes="card" IsVisible="{Binding IsResultVisible}">
        <StackPanel Spacing="16">
          <Border
              x:Name="ResultSummaryRegion"
              Classes="keyboard-focus"
              TabIndex="0"
              Focusable="True"
              AutomationProperties.LiveSetting="Polite"
              AutomationProperties.Name="{Binding LiveAnnouncement}">
            <StackPanel Spacing="6">
              <TextBlock AutomationProperties.HeadingLevel="2" Classes="section-title" Text="Inspected plan summary" />
              <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <StackPanel Spacing="7">
            <TextBlock AutomationProperties.HeadingLevel="3" FontSize="18" FontWeight="SemiBold" Text="Observed installation state" />
            <TextBlock Text="{Binding ObservedStateDetail}" TextWrapping="Wrap" />
            <TextBlock Classes="muted" Text="{Binding CurrentReleaseDetail}" TextWrapping="Wrap" />
            <TextBlock Classes="muted" Text="{Binding TargetReleaseDetail}" TextWrapping="Wrap" />
            <Border
                x:Name="ReleaseRelationshipRegion"
                Padding="10"
                Background="{DynamicResource InstallerInsetBackgroundBrush}"
                CornerRadius="5">
              <StackPanel Spacing="3">
                <TextBlock
                    x:Name="ReleaseRelationshipHeading"
                    AutomationProperties.HeadingLevel="3"
                    FontWeight="SemiBold"
                    Text="Observed version relationship"
                    TextWrapping="Wrap" />
                <TextBlock x:Name="ReleaseRelationshipDetail" Text="{Binding ReleaseRelationshipDetail}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>

          <Border
              x:Name="PlanSafetyRegion"
              Padding="12"
              AutomationProperties.Name="Plan safety and recovery"
              Background="{DynamicResource InstallerInfoBackgroundBrush}"
              BorderBrush="{DynamicResource InstallerInfoBorderBrush}"
              BorderThickness="1"
              CornerRadius="6">
            <StackPanel Spacing="5">
              <TextBlock AutomationProperties.HeadingLevel="3" FontSize="18" FontWeight="SemiBold" Text="Plan safety and recovery" TextWrapping="Wrap" />
              <TextBlock Text="{Binding SafetyDetail}" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding SafetyRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PlanReviewFactRow">
                    <Grid Margin="0,3" ColumnDefinitions="2*,3*" AutomationProperties.Name="{Binding AccessibleName}">
                      <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="{Binding Label}" TextWrapping="Wrap" />
                      <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <StackPanel
              x:Name="ReceiptOwnedPathRegion"
              IsVisible="{Binding HasPathFactRows}"
              Spacing="7"
              AutomationProperties.Name="Managed file details">
            <TextBlock AutomationProperties.HeadingLevel="3" FontSize="18" FontWeight="SemiBold" Text="Managed file details" TextWrapping="Wrap" />
            <TextBlock Classes="muted" Text="{Binding PathFactSummary}" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding PathFactRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PlanReviewPathFactRow">
                  <Border Margin="0,3" Padding="10" AutomationProperties.Name="{Binding AccessibleName}" Background="{DynamicResource InstallerInsetBackgroundBrush}" CornerRadius="5">
                    <StackPanel Spacing="3">
                      <TextBlock FontWeight="SemiBold" Text="{Binding DisplayPath}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding ObservedState}" TextWrapping="Wrap" />
                      <TextBlock Classes="muted" Text="{Binding PlannedAction}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Spacing="7">
            <TextBlock AutomationProperties.HeadingLevel="3" FontSize="18" FontWeight="SemiBold" Text="Risk categories" />
            <TextBlock Classes="muted" Text="{Binding RiskSummary}" TextWrapping="Wrap" />
            <ItemsControl IsVisible="{Binding HasRiskRows}" ItemsSource="{Binding RiskRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PlanReviewSummaryRow">
                  <Border Margin="0,3" Padding="10" AutomationProperties.Name="{Binding AccessibleName}" Background="{DynamicResource InstallerInsetBackgroundBrush}" CornerRadius="5">
                    <StackPanel Spacing="3">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Label}" TextWrapping="Wrap" />
                      <TextBlock Classes="muted" Text="{Binding Detail}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Spacing="7">
            <TextBlock AutomationProperties.HeadingLevel="3" FontSize="18" FontWeight="SemiBold" Text="Planned file actions" />
            <TextBlock Classes="muted" Text="{Binding OperationSummary}" TextWrapping="Wrap" />
            <ItemsControl IsVisible="{Binding HasOperationRows}" ItemsSource="{Binding OperationRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PlanReviewSummaryRow">
                  <Border Margin="0,3" Padding="10" AutomationProperties.Name="{Binding AccessibleName}" Background="{DynamicResource InstallerInsetBackgroundBrush}" CornerRadius="5">
                    <StackPanel Spacing="3">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Label}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding CountText}" />
                      <TextBlock Classes="muted" Text="{Binding Detail}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Spacing="7">
            <TextBlock AutomationProperties.HeadingLevel="3" FontSize="18" FontWeight="SemiBold" Text="Blocking conflicts" />
            <TextBlock Classes="muted" Text="{Binding ConflictSummary}" TextWrapping="Wrap" />
            <ItemsControl IsVisible="{Binding HasConflictRows}" ItemsSource="{Binding ConflictRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PlanReviewSummaryRow">
                  <Border Margin="0,3" Padding="10" AutomationProperties.Name="{Binding AccessibleName}" Background="{DynamicResource InstallerErrorBackgroundBrush}" CornerRadius="5">
                    <StackPanel Spacing="3">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Label}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding CountText}" />
                      <TextBlock Classes="muted" Text="{Binding Detail}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Spacing="7">
            <TextBlock x:Name="CandidateSummaryHeading" AutomationProperties.HeadingLevel="3" FontSize="18" FontWeight="SemiBold" Text="Modified or unknown file candidates" TextWrapping="Wrap" />
            <TextBlock Classes="muted" Text="{Binding CandidateSummary}" TextWrapping="Wrap" />
            <ItemsControl IsVisible="{Binding HasCandidateRows}" ItemsSource="{Binding CandidateRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PlanReviewSummaryRow">
                  <Border Margin="0,3" Padding="10" AutomationProperties.Name="{Binding AccessibleName}" Background="{DynamicResource InstallerInsetBackgroundBrush}" CornerRadius="5">
                    <StackPanel Spacing="3">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Label}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding CountText}" />
                      <TextBlock Classes="muted" Text="{Binding Detail}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Spacing="5">
            <TextBlock AutomationProperties.HeadingLevel="3" FontSize="18" FontWeight="SemiBold" Text="Additional notices" />
            <TextBlock Text="{Binding AdditionalNoticeDetail}" TextWrapping="Wrap" />
          </StackPanel>

        </StackPanel>
      </Border>

      <Border
          x:Name="CandidateReviewRegion"
          Grid.Row="6"
          Classes="card"
          IsVisible="{Binding IsCandidateReviewVisible}"
          AutomationProperties.Name="Candidate review. Choices only refresh the read-only preview; no files change.">
        <StackPanel Spacing="12">
          <StackPanel Spacing="5">
            <TextBlock
                AutomationProperties.HeadingLevel="2"
                Classes="section-title"
                Text="Review modified or unknown files" />
            <TextBlock
                Text="{Binding CandidateReviewDetail}"
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="CandidateCapacityDetail"
                AutomationProperties.Name="{Binding CandidateCapacityDetail}"
                Classes="muted"
                FontWeight="SemiBold"
                IsVisible="{Binding IsCandidateCapacityDetailVisible}"
                Text="{Binding CandidateCapacityDetail}"
                TextWrapping="Wrap" />
            <TextBlock
                Classes="muted"
                Text="A backend-provisional label explains the inspected plan only. It is not your approval. There is intentionally no Select all control."
                TextWrapping="Wrap" />
          </StackPanel>

          <Border
              x:Name="CandidateSelectionStatusRegion"
              Classes="keyboard-focus"
              Focusable="True"
              TabIndex="10"
              AutomationProperties.LiveSetting="Polite"
              AutomationProperties.Name="{Binding CandidateSelectionAnnouncement}">
            <TextBlock
                FontWeight="SemiBold"
                Text="{Binding CandidateSelectionAnnouncement}"
                TextWrapping="Wrap" />
          </Border>

          <StackPanel IsVisible="{Binding HasCandidateChoices}" Spacing="6">
            <Label Content="_Files to include in the next preview" Target="{Binding #CandidateList}" />
            <ListBox
                x:Name="CandidateList"
                Classes="focus-ring"
                Focusable="True"
                MaxHeight="360"
                MinHeight="120"
                TabIndex="11"
                AutomationProperties.AccessKey="Alt+F"
                AutomationProperties.Name="Modified or unknown file candidates"
                AutomationProperties.HelpText="Use Up and Down Arrow to move through files and Space to toggle one choice. All choices start unchecked."
                IsEnabled="{Binding IsCandidateSelectionEnabled}"
                ItemsSource="{Binding CandidateChoices}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                SelectionMode="Single">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:PlanReviewCandidateChoice">
                  <CheckBox
                      Margin="3"
                      Padding="8"
                      AutomationProperties.Name="{Binding AccessibleName}"
                      IsChecked="{Binding IsSelected, Mode=TwoWay}">
                    <StackPanel MaxWidth="760" Spacing="3">
                      <TextBlock FontWeight="SemiBold" Text="{Binding DisplayPath}" TextWrapping="Wrap" />
                      <TextBlock Classes="muted" Text="{Binding ReasonDetail}" TextWrapping="Wrap" />
                      <TextBlock Classes="muted" Text="{Binding DispositionDetail}" TextWrapping="Wrap" />
                      <TextBlock Classes="muted" Text="{Binding ProvisionalDetail}" TextWrapping="Wrap" />
                    </StackPanel>
                  </CheckBox>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>

          <WrapPanel Orientation="Horizontal">
            <Button
                x:Name="ApplyCandidatesButton"
                Classes="primary focus-ring"
                Margin="0,0,12,10"
                TabIndex="12"
                AutomationProperties.AccessKey="Alt+A"
                AutomationProperties.Name="Add selected file approvals to a new read-only preview"
                AutomationProperties.HelpText="Sends only the checked files as additive approvals and requests a newly validated preview. It does not change files, confirm, or execute the plan."
                Command="{Binding ApplyCandidatesCommand}"
                Content="_Apply additive approvals" />
            <Button
                x:Name="ClearCandidatesButton"
                Classes="focus-ring"
                Margin="0,0,12,10"
                TabIndex="13"
                AutomationProperties.AccessKey="Alt+L"
                AutomationProperties.Name="Clear local candidate choices"
                AutomationProperties.HelpText="Unchecks the current local choices without contacting the backend."
                Command="{Binding ClearCandidatesCommand}"
                Content="C_lear local choices" />
            <Button
                x:Name="StartFreshInspectionButton"
                Classes="focus-ring"
                Margin="0,0,12,10"
                TabIndex="14"
                AutomationProperties.AccessKey="Alt+R"
                AutomationProperties.Name="Start a fresh candidate inspection"
                AutomationProperties.HelpText="Revokes the current preview and requests a new initial read-only inspection. It does not undo prior backend decisions, change files, confirm, or execute the plan."
                Command="{Binding StartFreshInspectionCommand}"
                Content="Start f_resh inspection" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <Border
          Grid.Row="7"
          Classes="card"
          IsVisible="{Binding IsConfirmVisible}"
          AutomationProperties.Name="Final confirmation after plan and candidate review">
        <StackPanel Spacing="10">
          <TextBlock AutomationProperties.HeadingLevel="2" Classes="section-title" Text="Confirm this exact plan" />
          <TextBlock Text="{Binding ConfirmationDetail}" TextWrapping="Wrap" />
          <Button
              x:Name="ConfirmButton"
              Classes="primary focus-ring"
              HorizontalAlignment="Left"
              TabIndex="15"
              AutomationProperties.AccessKey="Alt+S"
              AutomationProperties.Name="Confirm this exact reviewed plan"
              AutomationProperties.HelpText="Confirmation changes no files and opens a separate final Run screen."
              Command="{Binding ConfirmCommand}"
              Content="Confirm reviewed plan (_S)" />
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</Window>
