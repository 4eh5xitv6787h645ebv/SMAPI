<Application
    x:Class="StardewModdingAPI.Installer.Gui.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Background" Value="#10151F" />
      <Setter Property="Foreground" Value="#EDF3FA" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#182230" />
      <Setter Property="BorderBrush" Value="#34465A" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="20" />
    </Style>
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="19" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#B6C4D4" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#7B61FF" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="18,10" />
    </Style>
    <Style Selector="Button.focus-ring:focus-visible, ComboBox.focus-ring:focus-visible">
      <Setter Property="BorderBrush" Value="#FFE082" />
      <Setter Property="BorderThickness" Value="3" />
    </Style>
  </Application.Styles>
</Application>
