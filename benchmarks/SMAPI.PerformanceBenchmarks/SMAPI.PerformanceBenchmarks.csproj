<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>SMAPI.PerformanceBenchmarks</AssemblyName>
    <RootNamespace>SMAPI.PerformanceBenchmarks</RootNamespace>
    <TieredCompilation>false</TieredCompilation>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <Import Project="..\..\build\common.targets" />

  <ItemGroup>
    <ProjectReference Include="..\..\src\SMAPI.Toolkit\SMAPI.Toolkit.csproj" />
    <ProjectReference Include="..\..\src\SMAPI\SMAPI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Stardew Valley" HintPath="$(GamePath)\Stardew Valley.dll" Private="True" />
    <Reference Include="StardewValley.GameData" HintPath="$(GamePath)\StardewValley.GameData.dll" Private="True" />
    <Reference Include="MonoGame.Framework" HintPath="$(GamePath)\MonoGame.Framework.dll" Private="True" />
    <Reference Include="xTile" HintPath="$(GamePath)\xTile.dll" Private="True" />
  </ItemGroup>
</Project>
